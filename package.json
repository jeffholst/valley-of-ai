{
  "name": "valley-of-ai",
  "version": "0.2.0",
  "description": "An AI-powered gallery of mini-apps built nightly by LLMs from community suggestions.",
  "author": "Jeff Holst",
  "license": "MIT",
  "homepage": "https://www.valleyofai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffholst/valley-of-ai"
  },
  "bugs": {
    "url": "https://github.com/jeffholst/valley-of-ai/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "npm run sync && next dev",
    "build": "npm run sync && next build",
    "start": "next start",
    "sync": "node scripts/sync-public-content.mjs",
    "sync:categories": "node scripts/sync-categories.mjs",
    "generate:apps": "node scripts/generate-apps.mjs",
    "generate:posts": "node scripts/generate-posts.mjs",
    "validate:posts": "node scripts/validate-posts.mjs",
    "generate:app-votes": "node scripts/generate-app-vote-stats.mjs",
    "generate:versus": "node scripts/generate-versus.mjs",
    "validate:apps": "node scripts/validate-apps.mjs",
    "validate:responsive": "node scripts/validate-responsive.mjs",
    "validate:responsive:sample": "node scripts/validate-responsive.mjs --limit 5",
    "log": "node scripts/logger.mjs",
    "select:app:suggestion": "node scripts/issues/select-app-suggestion.mjs",
    "select:app:improvement": "node scripts/issues/select-app-improvement.mjs",
    "select:blog:suggestion": "node scripts/issues/select-blog-suggestion.mjs",
    "issues:pending": "node scripts/issues/retrieve-pending-issues.mjs",
    "issues:decide": "node scripts/issues/decide-issue.mjs",
    "deploy:latest": "git commit --allow-empty -m \"chore: deploy latest\" && git push",
    "db:push": "npx supabase db push",
    "db:diff": "npx supabase db diff",
    "migration:new": "npx supabase migration new",
    "agent": "node scripts/agent.mjs",
    "lint": "eslint app components hooks lib scripts __tests__ --max-warnings 0",
    "lint:fix": "eslint app components hooks lib scripts __tests__ --fix",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx}\" \"components/**/*.{js,jsx,ts,tsx}\" \"hooks/**/*.{js,jsx,ts,tsx}\" \"lib/**/*.{js,jsx,ts,tsx}\" \"scripts/**/*.{js,jsx,ts,tsx,mjs}\" \"__tests__/**/*.{js,jsx,ts,tsx}\" \"data/**/*.json\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/typography": "^0.5.20",
    "bad-words": "^4.0.0",
    "commander": "^14.0.3",
    "fuse.js": "^7.4.2",
    "gray-matter": "^4.0.3",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-turnstile": "^1.1.5",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "stripe": "22.2.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.7",
    "playwright": "^1.61.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1"
  }
}
