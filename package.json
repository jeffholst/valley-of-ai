{
  "name": "valley-of-ai",
  "version": "0.2.0",
  "description": "An AI-powered gallery of mini-apps built nightly by LLMs from community suggestions.",
  "author": "Jeff Holst",
  "license": "MIT",
  "homepage": "https://www.valleyofai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffholst/valley-of-ai"
  },
  "bugs": {
    "url": "https://github.com/jeffholst/valley-of-ai/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "npm run sync && next dev",
    "build": "npm run sync && next build",
    "start": "next start",
    "sync": "node scripts/sync-public-content.js",
    "generate:apps": "node scripts/generate-apps.js",
    "generate:versus": "node scripts/generate-versus.js",
    "validate:apps": "node scripts/validate-apps.js",
    "validate:responsive": "node scripts/validate-responsive.js",
    "validate:responsive:sample": "node scripts/validate-responsive.js --limit 5",
    "log": "node scripts/logger.js",
    "select:app:suggestion": "node scripts/issues/select-app-suggestion.js",
    "select:app:improvement": "node scripts/issues/select-app-improvement.js",
    "issues:pending": "node scripts/issues/retrieve-pending-issues.js",
    "issues:decide": "node scripts/issues/decide-issue.js",
    "agent": "node scripts/agent.js",
    "lint": "eslint app components hooks lib scripts __tests__ --max-warnings 0",
    "lint:fix": "eslint app components hooks lib scripts __tests__ --fix",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx}\" \"components/**/*.{js,jsx,ts,tsx}\" \"hooks/**/*.{js,jsx,ts,tsx}\" \"lib/**/*.{js,jsx,ts,tsx}\" \"scripts/**/*.{js,jsx,ts,tsx}\" \"__tests__/**/*.{js,jsx,ts,tsx}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.98.0",
    "commander": "^12.0.0",
    "next": "^16.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-turnstile": "^1.1.5",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^15.2.10",
    "playwright": "^1.58.2",
    "postcss": "^8.4.38",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.3"
  }
}
