{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valleyofai.com/schemas/design.json",
  "title": "App Design Spec",
  "type": "object",
  "required": ["id", "summary", "userFlows", "layout", "mechanics", "stateModel", "edgeCases"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "userFlows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string", "minLength": 3 },
          "description": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          }
        },
        "additionalProperties": false
      }
    },
    "layout": {
      "type": "object",
      "required": ["screens"],
      "properties": {
        "screens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "description"],
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "name": { "type": "string", "minLength": 3 },
              "description": { "type": "string", "minLength": 5 },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "role"],
                  "properties": {
                    "type": { "type": "string" },
                    "role": { "type": "string" },
                    "notes": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "mechanics": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "scoring": {
          "type": "string"
        },
        "winConditions": {
          "type": "string"
        },
        "loseConditions": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stateModel": {
      "type": "object",
      "required": ["properties"],
      "properties": {
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type", "description"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "initialStateDescription": { "type": "string" }
      },
      "additionalProperties": false
    },
    "edgeCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 5 },
          "expectedBehavior": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "theming": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "object",
          "properties": {
            "bg": { "type": "string" },
            "surface": { "type": "string" },
            "primary": { "type": "string" },
            "text": { "type": "string" }
          },
          "additionalProperties": true
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "thumbnailGuidance": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
