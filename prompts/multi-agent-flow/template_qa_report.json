{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valleyofai.com/schemas/qa-report.json",
  "title": "QA Report",
  "type": "object",
  "required": ["runId", "appId", "status", "checks"],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run-[0-9TzZ:-]+-[0-9a-fA-F]{6}$"
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "fail", "n/a"] },
          "severity": {
            "type": "string",
            "enum": ["blocking", "recommended", "nice_to_have"],
            "default": "recommended"
          },
          "details": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "blockingIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "stepsToReproduce": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "recommendedImprovements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "testedViewports": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 0
    },
    "testedThemes": {
      "type": "array",
      "items": { "type": "string", "enum": ["light", "dark"] },
      "minItems": 0,
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
