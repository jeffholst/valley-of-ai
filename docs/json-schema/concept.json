{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valleyofai.com/schemas/concept.json",
  "title": "App Concept",
  "type": "object",
  "required": ["id", "category", "title", "goal", "targetUser", "uniqueAngle", "constraints"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "App ID, lowercase kebab-case (e.g. 'neon-word-scramble')."
    },
    "category": {
      "type": "string",
      "enum": [
        "Games",
        "Productivity",
        "Utilities",
        "Design",
        "Education",
        "Entertainment",
        "Visualizations",
        "Icebreakers"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "goal": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "targetUser": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
    },
    "uniqueAngle": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "constraints": {
      "type": "object",
      "required": ["staticOnly", "noExternalApis", "mobileFirst"],
      "properties": {
        "staticOnly": { "type": "boolean" },
        "noExternalApis": { "type": "boolean" },
        "mobileFirst": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "inspirations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 10
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 30
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    },
    "suggestionId": {
      "type": "string",
      "description": "ID of suggestion this concept is based on, if any."
    }
  },
  "additionalProperties": false
}
