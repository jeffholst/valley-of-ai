# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# GitHub Suggestions (server-side only)
GITHUB_SUGGESTIONS_TOKEN=your-fine-grained-pat
GITHUB_REPO=owner/repo-name

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Site config
NEXT_PUBLIC_SITE_NAME=Valley of AI
NEXT_PUBLIC_MAIN_SITE_URL=https://www.valleyofai.com

# Social
NEXT_PUBLIC_SOCIAL_X_URL=https://x.com/your-handle
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://facebook.com/your-page
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://instagram.com/your-handle

# GitHub Repo
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-repo

# Stripe (payments / tipping)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key
STRIPE_SECRET_KEY=sk_live_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
