# Supabase (server-only — never expose these to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# GitHub Suggestions (server-side only)
GITHUB_SUGGESTIONS_TOKEN=your-fine-grained-pat
GITHUB_REPO=owner/repo-name

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Site config
NEXT_PUBLIC_SITE_NAME=Your Site Name
NEXT_PUBLIC_SITE_DESCRIPTION=A gallery of apps built by AI agents.
NEXT_PUBLIC_SITE_EMOJI=🤖
NEXT_PUBLIC_SITE_AUTHOR=Your Name
NEXT_PUBLIC_MAIN_SITE_URL=https://www.your-domain.com
# Prefix for localStorage vote keys — use a short unique slug (e.g. your project abbreviation)
NEXT_PUBLIC_STORAGE_PREFIX=app

# Social
NEXT_PUBLIC_SOCIAL_X_URL=https://x.com/your-handle
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://facebook.com/your-page
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://instagram.com/your-handle
NEXT_PUBLIC_SOCIAL_DISCORD_URL=https://discord.gg/your-invite

# GitHub Repo
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-repo

# Stripe (payments / tipping)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_test_your-webhook-secret

# Giscus comments (GitHub Discussions-backed)
# Get repo-id and category-id from https://giscus.app after enabling Discussions + installing the app
NEXT_PUBLIC_GISCUS_REPO=owner/repo-name
NEXT_PUBLIC_GISCUS_REPO_ID=R_your-repo-id
NEXT_PUBLIC_GISCUS_CATEGORY=Blog Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_your-category-id

# Multiplayer sessions are persisted in Supabase through Next.js API routes.
