# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# EmailJS
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Site config
NEXT_PUBLIC_SITE_NAME=Valley of AI
NEXT_PUBLIC_MAIN_SITE_URL=https://www.valleyofai.com

# Social
NEXT_PUBLIC_SOCIAL_X_URL=https://x.com/your-handle
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://facebook.com/your-page
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://instagram.com/your-handle
