{
  "rules": {
    "sessions": {
      "$sessionId": {
        ".read": "$sessionId.matches(/^[A-HJ-NP-Z2-9]{4,10}$/)",
        ".write": "$sessionId.matches(/^[A-HJ-NP-Z2-9]{4,10}$/)",
        ".validate": "newData.hasChildren(['appId', 'appPath', 'moderatorId', 'createdAt']) || data.exists()",
        "appId": {
          ".validate": "newData.isString() && newData.val().length <= 64 && (!data.exists() || newData.val() === data.val())"
        },
        "appName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "appPath": {
          ".validate": "newData.isString() && newData.val().length <= 80 && (!data.exists() || newData.val() === data.val())"
        },
        "moderatorId": {
          ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64 && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "(!data.exists() && newData.val() === now) || newData.val() === data.val()"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|playing|ended)$/)"
        },
        "settings": {
          ".validate": "newData.hasChildren() || !newData.exists()"
        },
        "game": {
          ".validate": "newData.hasChildren() || !newData.exists()"
        },
        "players": {
          "$playerId": {
            ".validate": "$playerId.matches(/^[a-zA-Z0-9_-]{8,64}$/) && (newData.val() === null || (newData.hasChildren(['id', 'name']) && newData.child('id').val() === $playerId))",
            "id": {
              ".validate": "newData.isString() && newData.val() === $playerId"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "team": {
              ".validate": "newData.isString() && newData.val().matches(/^(A|B)$/)"
            },
            "joinedAt": {
              ".validate": true
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
